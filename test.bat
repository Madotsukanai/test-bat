    $base = [ErrorBand]::DetectBase($wav)

    $out = Join-Path $env:TEMP 'error_music.wav'
    [ErrorBand]::Render($wav, $data, $base, $out)

    [ErrorShow]::Run($out, $data, 0, 40, 'pitch')
    Remove-Item -LiteralPath $out -ErrorAction SilentlyContinue
}
catch {
    Write-Host ('ERROR: ' + $_.Exception.Message) -ForegroundColor Red
    exit 1
}
