public static class ErrorBand
{
    const int OutRate = 44100;
    const int ReleaseMs = 60;


    static float[] LoadTrimmed(string path, out int rate)
    {
        byte[] b = File.ReadAllBytes(path);
        if (b.Length < 12 || b[0] != 'R' || b[1] != 'I' || b[2] != 'F' || b[3] != 'F')
            throw new Exception("Not a WAV file: " + path);

        int pos = 12, fmtTag = 0, ch = 0, bits = 0, sr = 0, dataPos = -1, dataLen = 0;
        while (pos + 8 <= b.Length)
        {
            string id = Encoding.ASCII.GetString(b, pos, 4);
            int len = BitConverter.ToInt32(b, pos + 4);
            int body = pos + 8;
            if (id == "fmt ")
            {
                fmtTag = BitConverter.ToUInt16(b, body);
                ch = BitConverter.ToUInt16(b, body + 2);
                sr = BitConverter.ToInt32(b, body + 4);
                bits = BitConverter.ToUInt16(b, body + 14);
                if (fmtTag == 0xFFFE && len >= 26) fmtTag = BitConverter.ToUInt16(b, body + 24);
            }
            else if (id == "data")
            {
                dataPos = body;
                dataLen = len;
                if (dataLen < 0 || dataPos + dataLen > b.Length) dataLen = b.Length - dataPos;
                break;
            }
            if (len < 0) break;
            pos = body + len + (len & 1);
        }
        if (dataPos < 0 || ch < 1 || sr < 1) throw new Exception("Unsupported WAV layout");

        int bytes = bits / 8;
        if (bytes < 1 || bytes > 4) throw new Exception("Unsupported bit depth: " + bits);
        int frames = dataLen / (bytes * ch);
        float[] mono = new float[frames];
        for (int i = 0; i < frames; i++)
        {
            double acc = 0;
            for (int c = 0; c < ch; c++)
            {
                int o = dataPos + (i * ch + c) * bytes;
                double v;
                if (fmtTag == 3 && bytes == 4) v = BitConverter.ToSingle(b, o);
                else if (bytes == 1) v = (b[o] - 128) / 128.0;
                else if (bytes == 2) v = BitConverter.ToInt16(b, o) / 32768.0;
                else if (bytes == 3) v = (((b[o + 2] << 24) | (b[o + 1] << 16) | (b[o] << 8)) >> 8) / 8388608.0;
                else v = BitConverter.ToInt32(b, o) / 2147483648.0;
                acc += v;
            }
            mono[i] = (float)(acc / ch);
        }

        float peak = 0;
        for (int i = 0; i < frames; i++) { float a = Math.Abs(mono[i]); if (a > peak) peak = a; }
        if (peak <= 0) throw new Exception("The WAV file is silent");

        int first = 0;
        while (first < frames && Math.Abs(mono[first]) < peak * 0.02f) first++;
        first = Math.Max(0, first - 32);

        float[] r = new float[Math.Max(frames - first, 4)];
        Array.Copy(mono, first, r, 0, frames - first);
        rate = sr;
        return r;
    }


    public static int DetectBase(string wavPath)
    {
        int rate;
        float[] s = LoadTrimmed(wavPath, out rate);
        int n = Math.Min(s.Length, rate / 2);
        if (n < 256) return 69;
        int best = 69;
        double bestP = -1;
        for (int note = 36; note <= 96; note++)
        {
            double f = 440.0 * Math.Pow(2.0, (note - 69) / 12.0);
            double coeff = 2.0 * Math.Cos(2.0 * Math.PI * f / rate);
            double s1 = 0, s2 = 0;
            for (int i = 0; i < n; i++)
            {
                double win = 0.5 - 0.5 * Math.Cos(2.0 * Math.PI * i / (n - 1));
                double s0 = s[i] * win + coeff * s1 - s2;
                s2 = s1;
                s1 = s0;
            }
            double p = s1 * s1 + s2 * s2 - coeff * s1 * s2;
            if (p > bestP) { bestP = p; best = note; }
        }
        return best;
    }

    public static List<int[]> ParseNotes(string data)
    {
        List<int[]> notes = new List<int[]>();
        string[] lines = data.Split('\n');
        for (int i = 0; i < lines.Length; i++)
        {
            string t = lines[i].Trim();
            if (t.Length == 0 || t[0] == '#') continue;
            string[] p = t.Split(',');
            if (p.Length < 4) continue;
            int[] nt = new int[5];
            for (int k = 0; k < 4; k++) nt[k] = int.Parse(p[k].Trim());
            if (p.Length > 4) nt[4] = int.Parse(p[4].Trim());
            notes.Add(nt);
        }
        return notes;
    }


    public static void Render(string wavPath, string data, int baseNote, string outPath)
    {
        int rate;
        float[] src = LoadTrimmed(wavPath, out rate);

        List<int[]> notes = ParseNotes(data);
        long maxEndMs = 0;
        for (int i = 0; i < notes.Count; i++) { long e = (long)notes[i][0] + notes[i][1]; if (e > maxEndMs) maxEndMs = e; }
        if (notes.Count == 0) throw new Exception("No notes");

        int total = (int)((maxEndMs + ReleaseMs) * OutRate / 1000) + 64;
        float[] mix = new float[total];
        int relS = ReleaseMs * OutRate / 1000;

        for (int ni = 0; ni < notes.Count; ni++)
        {
            int[] nt = notes[ni];
            double ratio = Math.Pow(2.0, (nt[2] - baseNote) / 12.0);
            double step = ratio * rate / OutRate;
            int startS = (int)((long)nt[0] * OutRate / 1000);
            int holdS = (int)((long)nt[1] * OutRate / 1000);
            int len = holdS + relS;
            int srcLen = (int)((src.Length - 2) / step);
            if (len > srcLen) len = srcLen;
            if (startS + len > total) len = total - startS;
            float gain = nt[3] / 127f;
            double pos = 0;
            for (int i = 0; i < len; i++)
            {
                int ip = (int)pos;
                float fr = (float)(pos - ip);
                float v = src[ip] + (src[ip + 1] - src[ip]) * fr;
                float g = gain;
                if (i > holdS) g *= 1f - (float)(i - holdS) / relS;
                mix[startS + i] += v * g;
                pos += step;
            }
        }


        float peak = 0;
        for (int i = 0; i < total; i++) { float a = Math.Abs(mix[i]); if (a > peak) peak = a; }
        if (peak <= 0) throw new Exception("Rendered silence");
        int[] hist = new int[1024];
        for (int i = 0; i < total; i++)
        {
            int bin = (int)(Math.Abs(mix[i]) / peak * 1023f);
            hist[bin]++;
        }
        long target = (long)(total * 0.999), cum = 0;
        int pb = 1023;
        for (int i = 0; i < 1024; i++) { cum += hist[i]; if (cum >= target) { pb = i; break; } }
        double p999 = Math.Max((pb + 1) / 1024.0 * peak, peak * 0.05);
        double scale = 0.9 / p999;

        byte[] pcm = new byte[total * 2];
        for (int i = 0; i < total; i++)
        {
            double y = Math.Tanh(mix[i] * scale) * 32000.0;
            short sv = (short)y;
            pcm[i * 2] = (byte)(sv & 0xFF);
            pcm[i * 2 + 1] = (byte)((sv >> 8) & 0xFF);
        }

        using (FileStream fs = new FileStream(outPath, FileMode.Create, FileAccess.Write))
        using (BinaryWriter bw = new BinaryWriter(fs))
        {
            bw.Write(Encoding.ASCII.GetBytes("RIFF"));
            bw.Write(36 + pcm.Length);
            bw.Write(Encoding.ASCII.GetBytes("WAVE"));
            bw.Write(Encoding.ASCII.GetBytes("fmt "));
            bw.Write(16);
            bw.Write((short)1);
            bw.Write((short)1);
            bw.Write(OutRate);
            bw.Write(OutRate * 2);
            bw.Write((short)2);
            bw.Write((short)16);
            bw.Write(Encoding.ASCII.GetBytes("data"));
            bw.Write(pcm.Length);
            bw.Write(pcm);
        }
    }
}


public class NoticeForm : Form
{
    protected override bool ShowWithoutActivation { get { return true; } }
    protected override CreateParams CreateParams
    {
        get
        {
            CreateParams cp = base.CreateParams;
            cp.ExStyle |= 0x08000000;
            return cp;
        }
    }
}

public static class ErrorShow
{
    [DllImport("user32.dll")] static extern short GetAsyncKeyState(int vKey);
    [DllImport("user32.dll")] static extern bool SetProcessDPIAware();

    static readonly string[] Messages = new string[] {
        "\u30a8\u30e9\u30fc\u304c\u767a\u751f\u3057\u307e\u3057\u305f\u3002",
        "\u4e88\u671f\u3057\u306a\u3044\u30a8\u30e9\u30fc\u304c\u767a\u751f\u3057\u307e\u3057\u305f\u3002",
        "\u64cd\u4f5c\u3092\u5b8c\u4e86\u3067\u304d\u307e\u305b\u3093\u3067\u3057\u305f\u3002",
        "\u554f\u984c\u304c\u767a\u751f\u3057\u305f\u305f\u3081\u3001\u51e6\u7406\u3092\u7d9a\u884c\u3067\u304d\u307e\u305b\u3093\u3002"
    };


    static Form MakeDialog(double fx, int laneTop, int bandH, Rectangle wa, float sc, Bitmap icon, int msgIdx, int laneNo)
    {
        int capH = SystemInformation.CaptionHeight + SystemInformation.FrameBorderSize.Height * 2 + 8;
        double k = (bandH - capH) / (120.0 * sc);
        if (k > 1.0) k = 1.0;
        if (k < 0.35) k = 0.35;
        float s = (float)(sc * k);
        int w = (int)(340 * s), h = (int)(120 * s);

        Form f = new NoticeForm();
        f.Text = "\u30a8\u30e9\u30fc " + (laneNo + 1);
        f.FormBorderStyle = FormBorderStyle.FixedDialog;
        f.MaximizeBox = false;
        f.MinimizeBox = false;
        f.ShowInTaskbar = false;
        f.TopMost = true;
        f.StartPosition = FormStartPosition.Manual;
        f.ClientSize = new Size(w, h);

        PictureBox pb = new PictureBox();
        pb.Image = icon;
        pb.SizeMode = PictureBoxSizeMode.StretchImage;
        pb.Location = new Point((int)(16 * s), (int)(20 * s));
        pb.Size = new Size((int)(32 * s), (int)(32 * s));
        f.Controls.Add(pb);

        Label lb = new Label();
        lb.Text = Messages[msgIdx % Messages.Length];
        lb.Font = new Font(lb.Font.FontFamily, (float)Math.Max(6.0, lb.Font.Size * k), lb.Font.Style);
        lb.Location = new Point((int)(62 * s), (int)(22 * s));
        lb.Size = new Size((int)(260 * s), (int)(44 * s));
        f.Controls.Add(lb);

        Button ok = new Button();
        ok.Text = "OK";
        ok.Font = lb.Font;
        ok.Location = new Point((int)(w - 96 * s), (int)(h - 38 * s));
        ok.Size = new Size((int)(80 * s), (int)(26 * s));
        f.Controls.Add(ok);

        fx = Math.Max(0.0, Math.Min(1.0, fx));
        int x = wa.Left + (int)(fx * Math.Max(1, wa.Width - f.Width));
        int y = laneTop + Math.Max(0, (bandH - f.Height) / 2);
        f.Location = new Point(x, y);
        return f;
    }



    public static void Run(string wavPath, string data, int offsetMs, int maxLive, string xMode)
    {
        List<int[]> all = ParseSorted(data);
        List<int[]> notes = new List<int[]>();
        HashSet<long> seen = new HashSet<long>();
        int lo = 127, hi = 0;
        long songMs = 1;
        Dictionary<int, double> sum = new Dictionary<int, double>();
        Dictionary<int, int> cnt = new Dictionary<int, int>();
        for (int i = 0; i < all.Count; i++)
        {
            long key = (long)all[i][0] * 256 + all[i][2];
            if (!seen.Add(key)) continue;
            notes.Add(all[i]);
            if (all[i][2] < lo) lo = all[i][2];
            if (all[i][2] > hi) hi = all[i][2];
            if (all[i][0] > songMs) songMs = all[i][0];
            int c = all[i][4];
            if (!sum.ContainsKey(c)) { sum[c] = 0; cnt[c] = 0; }
            sum[c] += all[i][2];
            cnt[c]++;
        }


        List<int> chs = new List<int>(sum.Keys);
        chs.Sort(delegate(int a, int b) { return (sum[b] / cnt[b]).CompareTo(sum[a] / cnt[a]); });
        Dictionary<int, int> laneOf = new Dictionary<int, int>();
        for (int i = 0; i < chs.Count; i++) laneOf[chs[i]] = i;

        try { SetProcessDPIAware(); } catch (Exception) { }
        Application.EnableVisualStyles();
        float sc = 1f;
        using (Graphics g = Graphics.FromHwnd(IntPtr.Zero)) sc = g.DpiX / 96f;
        Rectangle wa = Screen.PrimaryScreen.WorkingArea;
        int bandH = wa.Height / Math.Max(1, chs.Count);
        Bitmap icon = SystemIcons.Error.ToBitmap();
        bool byTime = (xMode != null && xMode.ToLower() == "time");

        List<Form> live = new List<Form>();
        List<long> endAt = new List<long>();
        SoundPlayer sp = new SoundPlayer(wavPath);
        sp.Load();
        sp.Play();
        Stopwatch sw = Stopwatch.StartNew();
        int idx = 0, count = 0;

        while (true)
        {
            long now = sw.ElapsedMilliseconds - offsetMs;

            while (idx < notes.Count && notes[idx][0] <= now)
            {
                int[] nt = notes[idx++];
                if (now - nt[0] > 250) continue;
                while (live.Count >= maxLive) { CloseAt(live, endAt, 0); }
                int lane = laneOf[nt[4]];
                double fx = byTime ? (double)nt[0] / songMs
                                   : (hi > lo ? (double)(nt[2] - lo) / (hi - lo) : 0.5);
                Form f = MakeDialog(fx, wa.Top + lane * bandH, bandH, wa, sc, icon, count++, lane);
                f.Show();
                live.Add(f);
                endAt.Add(nt[0] + Math.Min(2000, Math.Max(150, nt[1])));
            }

            for (int i = live.Count - 1; i >= 0; i--)
                if (endAt[i] <= now) CloseAt(live, endAt, i);

            if (idx >= notes.Count && live.Count == 0) break;
            Application.DoEvents();
            if ((GetAsyncKeyState(0x1B) & 0x8000) != 0) break;
            Thread.Sleep(2);
        }

        sp.Stop();
        while (live.Count > 0) CloseAt(live, endAt, 0);
    }

    static void CloseAt(List<Form> live, List<long> endAt, int i)
    {
        try { live[i].Close(); } catch (Exception) { }
        live.RemoveAt(i);
        endAt.RemoveAt(i);
    }

    static List<int[]> ParseSorted(string data)
    {
        List<int[]> n = ErrorBand.ParseNotes(data);
        n.Sort(delegate(int[] a, int[] b) { if (a[0] != b[0]) return a[0].CompareTo(b[0]); if (a[2] != b[2]) return a[2].CompareTo(b[2]); return a[4].CompareTo(b[4]); });
        return n;
    }
}
